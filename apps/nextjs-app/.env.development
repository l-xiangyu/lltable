#######################################################################################
# 本地开发环境专属（pnpm dev 时加载：.env + 本文件）
# 按本机实际情况修改域名、数据库、OIDC 回调
#######################################################################################

LOG_LEVEL=debug
NEXT_PUBLIC_BUILD_VERSION=develop
NEXT_BUILD_ENV_SENTRY_ENABLED=true

PORT=3000
SOCKET_PORT=3001

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
APP_CACHE_DSN=

API_DOC_ENABLED_SNIPPET=true
I18N_TYPES_OUTPUT_PATH=./src/types/i18n.generated.ts
CALC_CHUNK_SIZE=400

# 对外访问地址（本地）
PUBLIC_ORIGIN=http://localhost:3000
STORAGE_PREFIX=http://localhost:3000

# 本地附件存储
BACKEND_STORAGE_PUBLIC_URL=http://localhost:3000/api/attachments/read/public
BACKEND_STORAGE_LOCAL_PATH=./.local-storage

# 本地数据库
PRISMA_DATABASE_URL=postgresql://postgres:123456@192.168.1.106:5432/teable?schema=public
PUBLIC_DATABASE_PROXY=192.168.1.106:5432

BACKEND_CACHE_PROVIDER=memory

# 本地/联调密钥（勿与生产相同）
SECRET_KEY=mYZH45N23cLfsiDRmYfDLYyPJ9YBab2NnZRbYzetgGuGfYWz69KVkJxR7NajTnoQqY

# OIDC：主系统端点（联调环境）
BACKEND_OIDC_ISSUER=https://saas-server.skyxsx.top
BACKEND_OIDC_AUTHORIZATION_URL=https://saas-server.skyxsx.top/teable/oidc/authorize
BACKEND_OIDC_TOKEN_URL=https://saas-server.skyxsx.top/teable/oidc/token
BACKEND_OIDC_USER_INFO_URL=https://saas-server.skyxsx.top/teable/oidc/userinfo
# 回调须与主系统登记一致，改为你的本地/隧道域名
BACKEND_OIDC_CALLBACK_URL=https://teable.skyxsx.top/api/auth/oidc/callback

# 这些 Host 下显示登录页，不强制跳 OIDC
ALLOW_HOME_LOGIN_HOST=mtesting.smyun.net,localhost:1025,localhost:3000,192.168.1.100:3000,lltable.smyun.net

# 开发可 true 走 SSO；需要密码登录时改为 false
PASSWORD_LOGIN_DISABLED=true
