#######################################################################################
# 生产环境专属（服务器执行 deploy-on-server.sh production 时加载：.env + 本文件）
# 部署前按生产域名、数据库、存储路径逐项核对
#######################################################################################

LOG_LEVEL=info
NEXT_PUBLIC_BUILD_VERSION=x.x.x
NEXT_BUILD_ENV_ASSET_PREFIX=

# 端口（生产固定 3000）
PORT=3000
SOCKET_PORT=3000

# 对外访问地址（生产域名）
PUBLIC_ORIGIN=https://lltable.smyun.net
STORAGE_PREFIX=https://lltable.smyun.net

# 生产密钥（必须与测试、开发不同）
SECRET_KEY=mYZH45N23cLfsiDRmYfDLYyPJ9YBab2NnZRbYzetgGuGfYWz69KVkJxR7NajTnoQqY

# 附件存储（生产机路径须有写权限）
BACKEND_STORAGE_PUBLIC_URL=https://lltable.smyun.net/api/attachments/read/public
BACKEND_STORAGE_LOCAL_PATH=/jbs/attachment/lltable/

# 生产数据库（勿连测试库）
PRISMA_DATABASE_URL=postgresql://postgres:He9v0uw7y7KRVa@127.0.0.1:5432/teable?schema=public&statement_cache_size=1
PUBLIC_DATABASE_PROXY=127.0.0.1:5432

BACKEND_CACHE_PROVIDER=sqlite
# BACKEND_CACHE_REDIS_URI=redis://default:password@127.0.0.1:6379/0
# BACKEND_PERFORMANCE_CACHE=redis://default:password@127.0.0.1:6379/0

# OIDC：生产主系统端点
BACKEND_OIDC_ISSUER=https://jbs.backend.smyun.net
BACKEND_OIDC_AUTHORIZATION_URL=https://jbs.backend.smyun.net/teable/oidc/authorize
BACKEND_OIDC_TOKEN_URL=https://jbs.backend.smyun.net/teable/oidc/token
BACKEND_OIDC_USER_INFO_URL=https://jbs.backend.smyun.net/teable/oidc/userinfo
# 回调须在主系统 OIDC 白名单中登记
BACKEND_OIDC_CALLBACK_URL=https://lltable.smyun.net/api/auth/oidc/callback

ALLOW_HOME_LOGIN_HOST=127.0.0.1:3000,smyun.skyxsx.top
PASSWORD_LOGIN_DISABLED=true

# 模板中心（按需填写）
TEMPLATE_SPACE_ID=your-template-space-id

# 统计（不用可保持占位）
MICROSOFT_CLARITY_ID=your-metrics-id
UMAMI_WEBSITE_ID=your-umami-website-id
UMAMI_URL=https://umami.example.com/script.js
GA_ID=your-google-analytics-id

