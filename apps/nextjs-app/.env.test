#######################################################################################
# 测试环境专属（服务器执行 deploy-on-server.sh test 时加载：.env + 本文件）
# 按测试域名、测试库、测试 OIDC 回调修改；勿使用生产库与生产密钥
#######################################################################################

LOG_LEVEL=info
NEXT_PUBLIC_BUILD_VERSION=test

# 端口（与生产 3000 错开，同机部署必配）
PORT=2999
SOCKET_PORT=2999

# 对外访问地址（测试域名，按实际修改）
PUBLIC_ORIGIN=https://lltabletest.smyun.net
STORAGE_PREFIX=https://lltabletest.smyun.net

# 测试密钥（与生产不同）
SECRET_KEY=mYZH45N23cLfsiDRmYfDLYyPJ9YBab2NnZRbYzetgGuGfYWz69KVkJxR7NajTnoQqY

# 附件存储（测试机路径）
BACKEND_STORAGE_PUBLIC_URL=https://lltabletest.smyun.net/api/attachments/read/public
BACKEND_STORAGE_LOCAL_PATH=/jbs/attachment/lltable-test/

# 测试数据库（独立库 teable_test，勿连生产 teable）
PRISMA_DATABASE_URL=postgresql://postgres:He9v0uw7y7KRVa@127.0.0.1:5432/teable_test?schema=public&statement_cache_size=1
PUBLIC_DATABASE_PROXY=127.0.0.1:5432

BACKEND_CACHE_PROVIDER=memory
# BACKEND_CACHE_REDIS_URI=redis://default:password@127.0.0.1:6379/1

# OIDC：测试主系统端点（若与生产共用主系统，只改 CALLBACK_URL 为测试域名）
BACKEND_OIDC_ISSUER=https://staging.backend.smyun.net
BACKEND_OIDC_AUTHORIZATION_URL=https://staging.backend.smyun.net/teable/oidc/authorize
BACKEND_OIDC_TOKEN_URL=https://staging.backend.smyun.net/teable/oidc/token
BACKEND_OIDC_USER_INFO_URL=https://staging.backend.smyun.net/teable/oidc/userinfo
BACKEND_OIDC_CALLBACK_URL=https://lltabletest.smyun.net/api/auth/oidc/callback

ALLOW_HOME_LOGIN_HOST=mtesting.smyun.net,localhost:2999
# 配置了 OIDC 时必须为 true，禁用密码登录
PASSWORD_LOGIN_DISABLED=true

ENABLE_CANARY_FEATURE=true
CALC_CHUNK_SIZE=400
